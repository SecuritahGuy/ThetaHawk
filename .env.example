# Local research database and symbol universe
THETAHAWK_DATA_DIR=./data
THETAHAWK_SYMBOLS=AAPL,AMZN,ARM,GOOG,MSFT,NVDA
THETAHAWK_TIMEZONE=America/Chicago
THETAHAWK_STALE_QUOTE_SECONDS=900
THETAHAWK_DEMO_MODE=true

# Optional local MLX server. No model is called unless a research report is requested.
THETAHAWK_MLX_SERVER_URL=http://127.0.0.1:8080/v1
THETAHAWK_MLX_MODEL=Qwen/Qwen3-8B-MLX-4bit

# Optional Alpaca market-data access. This project uses market-data GETs only.
# Free options access is indicative data; choose opra only with the required subscription.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
THETAHAWK_ALPACA_STOCK_FEED=iex
THETAHAWK_ALPACA_OPTIONS_FEED=indicative
THETAHAWK_ALPACA_BROKER_URL=https://paper-api.alpaca.markets
THETAHAWK_EARNINGS_CSV=./data/earnings.csv
THETAHAWK_REALIZED_MOVES_CSV=./data/realized_moves.csv
# Optional SEC EDGAR access; use an application name and contact email per SEC guidance.
# THETAHAWK_SEC_USER_AGENT=Thetahawk research contact@example.com
