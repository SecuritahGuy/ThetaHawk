# Local research database and symbol universe
THETAHAWK_DATA_DIR=./data
THETAHAWK_SYMBOLS=AAPL,AMZN,ARM,GOOG,MSFT,NVDA
THETAHAWK_TIMEZONE=America/Chicago
THETAHAWK_STALE_QUOTE_SECONDS=900
THETAHAWK_DEMO_MODE=true

# Optional local MLX server. No model is called unless a research report is requested.
THETAHAWK_MLX_SERVER_URL=http://127.0.0.1:8080/v1
THETAHAWK_MLX_MODEL=Qwen/Qwen3-8B-MLX-4bit
